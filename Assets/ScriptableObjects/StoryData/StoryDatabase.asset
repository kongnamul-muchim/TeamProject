%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eceae12f278919743bdf14f47b157eea, type: 3}
  m_Name: StoryDatabase
  m_EditorClassIdentifier: HideAndInk::StoryDatabaseSO
  prologue:
  - speaker: "\uB124\uB808\uC774\uC158"
    text: "\uC885\uC774 \uBC14\uB2E4\uC5D0\uC11C \uCB49 \uC0B4\uC544\uC628 \uBB38\uC5B4
      \uB450\uB450. \uACBD\uC7C1\uC790\uC640 \uD3EC\uC2DD\uC790\uC758 \uC218\uAC00
      \uB4E4\uC5B4 \uBCF4\uAE08\uC790\uB9AC\uAC00 \uD669\uD3D0\uD574\uC84C\uC2B5\uB2C8\uB2E4."
    sceneId: 1-1
    cutsceneBg: {fileID: 21300000, guid: c0a462a299e456f469a9149833852230, type: 3}
  - speaker: "\uB450\uB450"
    text: "\uC0AC\uBC29\uC774 \uC628\uD1B5 \uAD6C\uACA8\uC9C4 \uC885\uC774 \uBC14\uC704
      \uBFD0\uC774\uC57C... \uC774\uC81C \uC5EC\uAE30\uC11C \uBA39\uC744 \uAC78 \uCC3E\uB294
      \uAC74 \uBD88\uAC00\uB2A5\uD574."
    sceneId: 1-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uBA3C \uBC14\uB2E4 \uAE4A\uC740 \uACF3\uC5D4 \uC544\uC9C1 \uAE68\uB057\uD55C
      \uBCF4\uAE08\uC790\uB9AC\uAC00 \uB0A8\uC544\uC788\uC744\uAE4C? \uBB34\uC12D\uC9C0\uB9CC...
      \uAC00\uBD10\uC57C\uACA0\uC5B4."
    sceneId: 1-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uC751? \uB10C \uBB50\uC57C? \uBB38\uC5B4\uCC98\uB7FC \uC0DD\uACBC\uB294\uB370...
      \uB098\uB791\uC740 \uC880 \uB2E4\uB974\uB124. \uC870\uAE08 \uC774\uC0C1\uD574.
      \uC774\uB984\uC774 \uBB50\uC57C?"
    sceneId: 2-1
    cutsceneBg: {fileID: 21300000, guid: d72b077090702d345a99074733250517, type: 3}
  - speaker: "\uCE58\uCE58"
    text: "\uCE58\uC9C1.. \uCE59."
    sceneId: 2-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uCE58\uCE58? \uC774\uB984\uC774 \uCE58\uCE58\uC57C? \uB108\uB3C4 \uBB38\uC5B4
      \uB9DE\uC9C0? \uC5EC\uAE30\uB294 \uD669\uD3D0\uD574. \uB108\uB3C4 \uC5EC\uAE38
      \uB5A0\uB098\uB294\uAC8C \uC88B\uC544."
    sceneId: 2-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "(\uC0DD\uD0DC\uACC4 \uC870\uC0AC\uB97C \uC704\uD574 \uBB38\uC5B4 \uAC1C\uCCB4
      \uAD00\uCC30 \uC911...) \uCE58\uCE59."
    sceneId: 3-1
    cutsceneBg: {fileID: 21300000, guid: d91c459a1ad75874d9ae40916f3ca55b, type: 3}
  - speaker: "\uB450\uB450"
    text: "\uC5B4? \uC65C \uB530\uB77C\uB2E4\uB2C8\uB294\uAC70\uC57C? \uACE4\uB780\uD55C\uB370...
      \uC5B4, \uC57C! \uC800\uAE30 \uD3EC\uC2DD\uC790\uAC00 \uC624\uC796\uC544! \uC5BC\uB978
      \uC228\uC5B4!"
    sceneId: 3-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "(\uD3EC\uC2DD\uC790\uC758 \uD589\uB3D9 \uD328\uD134 \uAD00\uCC30 \uC911...)
      ? \uCE58\uC9C0\uC9C1."
    sceneId: 3-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uD070 \uBB3C\uACE0\uAE30"
    text: "(\uAE68\uBB3C\uAE68\uBB3C...) ...? \uD264."
    sceneId: 3-4
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uC640... \uB108 \uC815\uB9D0 \uD2BC\uD2BC\uD558\uB2E4. \uD070 \uBB3C\uACE0\uAE30\uAC00
      \uACF5\uACA9\uD588\uB294\uB370\uB3C4 \uBA40\uCA61\uD574. \uC624\uD788\uB824
      \uC800 \uB140\uC11D\uC774 \uD765\uBBF8\uB97C \uC783\uACE0 \uB5A0\uB098\uBC84\uB838\uB124!"
    sceneId: 3-5
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: ...
    sceneId: 3-6
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uB0B4\uAC00 \uD558\uB294 \uB9D0 \uB4E3\uACE0 \uC788\uB294\uAC70 \uB9DE\uB2C8?
      \uC74C... \uB300\uD654 \uD1B5\uD558\uACE0 \uC788\uB294\uAC70 \uB9DE\uC9C0?"
    sceneId: 3-7
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "(\uAD00\uCC30 \uB300\uC0C1\uC758 \uC789\uD06C \uBD80\uC871 \uD604\uC0C1
      \uD30C\uC545. \uC789\uD06C\uB97C \uBCF4\uAE09 \uC9C4\uD589.) \uCE58\uC775."
    sceneId: 3-8
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uC5B4? \uB098\uD55C\uD14C \uBA39\uBB3C\uC744 \uB098\uB220\uC8FC\uB294
      \uAC70\uC57C? \uACE0\uB9C8\uC6CC! \uBB54\uAC00 \uC774\uC0C1\uD558\uC9C0\uB9CC
      \uCC29\uD55C \uCE5C\uAD6C\uB124."
    sceneId: 3-9
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uCE58\uCE58! \uB108\uB791 \uAC19\uC774 \uAC04\uB2E4\uBA74 \uC548\uC804\uD55C
      \uBCF4\uAE08\uC790\uB9AC\uB97C \uBC1C\uACAC\uD560 \uC218 \uC788\uC744 \uAC83
      \uAC19\uC544! \uAC19\uC774 \uAC00\uC790!"
    sceneId: 4-1
    cutsceneBg: {fileID: 21300000, guid: d797fea5f9746014a80c7a243a3872f7, type: 3}
  - speaker: "\uB124\uB808\uC774\uC158"
    text: "\uC774\uB807\uAC8C \uB450\uB450\uC640 \uCE58\uCE58\uC758 \uC885\uC774
      \uBC14\uB2E4\uB97C \uAC00\uB85C\uC9C0\uB974\uB294 \uC5EC\uC815\uC774 \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    sceneId: 4-1
    cutsceneBg: {fileID: 0}
  tutorialHints:
  - type: 0
    lines:
    - speaker: "\uCE58\uCE58"
      text: "[\uC2DC\uC2A4\uD15C] \uC8FC\uBCC0 \uC0AC\uBB3C\uACFC \uC0C9\uC0C1\uC744
        \uB3D9\uD654\uC2DC\uD0A4\uC138\uC694. \uD3EC\uC2DD\uC790\uC758 \uC758\uC2EC\uC744
        \uD53C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. (C\uD0A4: \uC758\uD0DC)"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 1
    lines:
    - speaker: "\uB450\uB450"
      text: "\uC704\uD5D8\uD574! \uBA39\uBB3C\uC744 \uB0B4\uBFDC\uC5B4\uC11C \uBE68\uB9AC
        \uBE60\uC838\uB098\uAC00\uC57C\uACA0\uC5B4! (Space: \uACE0\uC18D \uB3C4\uC8FC
        - \uBB34\uC801 \uC0C1\uD0DC)"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 2
    lines:
    - speaker: "\uB450\uB450"
      text: "\uBA39\uBB3C\uC774 \uB2E4 \uB5A8\uC5B4\uC84C\uC5B4... \uC6C0\uC9C1\uC774\uAE30\uAC00
        \uB108\uBB34 \uD798\uB4E4\uC5B4... \uCE58\uCE58, \uB3C4\uC640\uC918!"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 3
    lines:
    - speaker: "\uCE58\uCE58"
      text: "[\uBCF4\uAE09] \uC789\uD06C \uAC8C\uC774\uC9C0\uB97C \uC7AC\uCDA9\uC804\uD569\uB2C8\uB2E4.
        (X\uD0A4: \uCE58\uCE58 \uD638\uCD9C)"
      sceneId: 
      cutsceneBg: {fileID: 0}
  bossDialogues:
  - type: 0
    line:
      speaker: "\uB450\uB450"
      text: "\uC800 \uBFB0\uC871\uD55C \uCF54\uC5D0 \uCC14\uB9AC\uBA74 \uBB34\uC0AC\uD558\uC9C0
        \uBABB\uD560 \uAC70\uC57C. \uB0B4\uAC00 \uBD88\uC548\uD574\uD560\uC218\uB85D
        \uB354 \uBE68\uB9AC \uB3CC\uC9C4\uD574\uC624\uACA0\uC9C0? \uC5EC\uCC28\uD558\uBA74
        \uBC14\uC704\uC5D0 \uBD80\uB52A\uD788\uAC8C \uC720\uC778\uD574\uBCF4\uC790!"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 1
    line:
      speaker: "\uB450\uB450"
      text: "\uBAA8\uB798\uBC14\uB2E5\uC774 \uBBF8\uC138\uD558\uAC8C \uB5A8\uB9AC\uACE0
        \uC788\uC5B4... \uD639\uC2DC \uBC15\uC2A4 \uAC00\uC790\uBBF8\uAC00 \uC8FC\uBCC0\uC5D0
        \uC788\uB294\uAC78\uAE4C? \uB140\uC11D\uC758 \uADFC\uCC98\uC5D0 \uAC00\uBA74
        \uD280\uC5B4\uB098\uC640\uC11C \uB36E\uCE60 \uAC70\uC57C. \uC800 \uBAA8\uB798\uAD6C\uB369\uC774\uC5D0
        \uBE60\uC9C0\uBA74 \uBC1C\uC774 \uBB36\uC774\uB2C8 \uC870\uC2EC\uD574\uC57C
        \uD574!"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 2
    line:
      speaker: "\uB450\uB450"
      text: "\uC800 \uB140\uC11D, \uB0B4 \uC8FC\uBCC0\uC744 \uB9F4\uB3CC\uBA70 \uAE30\uD68C\uB97C
        \uC5FF\uBCF4\uACE0 \uC788\uC5B4. \uAC00\uB9CC\uD788 \uC788\uC73C\uBA74 \uC758\uC2EC\uB9CC
        \uC0B4 \uBFD0\uC774\uC57C. \uCC28\uB77C\uB9AC \uB3CC\uC9C4\uC744 \uC720\uB3C4\uD558\uACE0
        \uADF8 \uD2C8\uC5D0 \uB3C4\uB9DD\uCE58\uC790!"
      sceneId: 
      cutsceneBg: {fileID: 0}
  - type: 3
    line:
      speaker: "\uB450\uB450"
      text: "\uBC31\uC0C1\uC544\uB9AC\uC57C... \uC228\uC744 \uACF3\uC744 \uBB34\uC791\uC704\uB85C
        \uBD80\uC218\uACE0 \uC788\uC5B4! \uC740\uC2E0\uCC98\uAC00 \uC0AC\uB77C\uC9C0\uAE30
        \uC804\uC5D0 \uC9C0\uB098\uAC00\uC57C \uD574. \uB4E4\uD0A4\uB294 \uC21C\uAC04
        \uB05D\uC7A5\uC774\uC57C!"
      sceneId: 
      cutsceneBg: {fileID: 0}
  epilogue:
  - speaker: "\uB450\uB450"
    text: "\uC5EC\uAE30\uAC00 \uB0B4\uAC00 \uAFC8\uAFB8\uB358 \uC774\uC0C1\uC801\uC778
      \uBCF4\uAE08\uC790\uB9AC\uC57C! \uB530\uB73B\uD55C \uBAA8\uB798, \uB9D1\uC740
      \uBB3C... \uC774\uACF3\uC774 \uC0C8\uB85C\uC6B4 \uC9D1\uC774\uC57C."
    sceneId: 1-1
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "\uCE58\uCE58... \uB124\uAC00 \uC5C6\uC5C8\uB2E4\uBA74 \uC5EC\uAE30\uAE4C\uC9C0
      \uC624\uC9C0 \uBABB\uD588\uC744 \uAC70\uC57C. \uC815\uB9D0 \uACE0\uB9C8\uC6CC..."
    sceneId: 1-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uB124\uB808\uC774\uC158"
    text: "\uC2DC\uAC04\uC774 \uD750\uB974\uACE0, \uC0C8\uB85C\uC6B4 \uBCF4\uAE08\uC790\uB9AC\uC5D0\uC11C
      \uB450\uB450\uB294 \uC790\uC2E0\uC758 \uAC00\uC871\uC744 \uAFB8\uB9AC\uAC8C
      \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    sceneId: 2-1
    cutsceneBg: {fileID: 0}
  - speaker: "\uB450\uB450"
    text: "...\uCE58\uCE58. \uC774 \uBAA8\uB4E0 \uBAA8\uD5D8\uC774 \uB05D\uB0AC\uB294\uB370\uB3C4
      \uD568\uAED8 \uD574\uC8FC\uB294\uAD6C\uB098. \uACE0\uB9C8\uC6CC. \uADFC\uB370,
      \uBAB8\uC774 \uB108\uBB34 \uBB34\uAC81\uB2E4... \uB108\uBB34 \uC878\uB824.
      \uC774\uC81C \uAE34 \uC7A0\uC744 \uC790\uC57C\uACA0\uC5B4. ...\uC54C\uB4E4\uC744
      \uC798 \uBD80\uD0C1\uD574..."
    sceneId: 2-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "\uCE58\uC9C1...(\uAC1C\uCCB4 '\uB450\uB450'\uC758 \uB370\uC774\uD130 \uBCF4\uC874
      \uC911... \uC0DD\uBA85 \uBC18\uC751: \uC815\uC9C0)"
    sceneId: 2-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uB124\uB808\uC774\uC158"
    text: "\uB450\uB450\uC758 \uC5EC\uC815\uC740 \uC5EC\uAE30\uC11C \uBA48\uCDC4\uC9C0\uB9CC,
      \uADF8 \uAE30\uB85D\uC740 \uB05D\uB098\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    sceneId: 3-1
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "(\uC0DD\uBA85 \uBC18\uC751 \uD0D0\uC9C0... \uB2E4\uC218\uC758 \uC5B4\uB9B0
      \uAC1C\uCCB4 \uC6C0\uC9C1\uC784 \uD655\uC778.) ...\uCE58\uC9C1."
    sceneId: 3-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uC544\uAE30 \uBB38\uC5B4\uB4E4"
    text: "\uB2F9\uC2E0\uC740 \uB204\uAD6C\uC5D0\uC694? \uCE58\uCE58\uB77C\uACE0\uC694?"
    sceneId: 3-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "(\uAD00\uCC30 \uB370\uC774\uD130 \uC2DC\uCCAD \uBAA8\uB4DC \uD65C\uC131\uD654)
      ...\uCE58!"
    sceneId: 4-1
    cutsceneBg: {fileID: 0}
  - speaker: "\uC544\uAE30 \uBB38\uC5B4\uB4E4"
    text: "\uC640\uC544! \uC774 \uBAA8\uC2B5\uC740 \uC6B0\uB9AC \uC5C4\uB9C8\uC5D0\uC694?"
    sceneId: 4-2
    cutsceneBg: {fileID: 0}
  - speaker: "\uC544\uAE30 \uBB38\uC5B4\uB4E4"
    text: "\uBA39\uBB3C\uC740 \uC774\uB807\uAC8C \uC4F0\uB294\uAC70\uAD6C\uB098...
      \uC544, \uC704\uD5D8\uD560 \uB54C\uB294 \uC774\uB807\uAC8C \uB3C4\uB9DD\uCE58\uB294\uAC70\uC57C!
      ...\uC6B0\uB9AC\uB97C \uC704\uD574\uC11C \uC54C\uB824\uC8FC\uB294\uAC70\uC5D0\uC694?"
    sceneId: 4-3
    cutsceneBg: {fileID: 0}
  - speaker: "\uCE58\uCE58"
    text: "...(\uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4.)"
    sceneId: 4-4
    cutsceneBg: {fileID: 0}
  - speaker: "\uB124\uB808\uC774\uC158"
    text: "\uC885\uC774\uBC14\uB2E4 \uAE4A\uC740 \uACF3\uC5D0\uC11C, \uC791\uC740
      \uC885\uC774\uBB38\uC5B4 \uB450\uB450\uC758 \uC774\uC57C\uAE30\uB294 \uD6C4\uB300\uB97C
      \uC774\uC5B4 \uACC4\uC18D\uD574\uC11C \uC804\uD574\uC9C0\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    sceneId: 4-5
    cutsceneBg: {fileID: 0}
